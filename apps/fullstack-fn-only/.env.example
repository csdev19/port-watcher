# Database
DATABASE_URL=

# To set BETTER_AUTH_SECRET let's use = openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Optional. Public base URL of the R2 bucket with the desktop DMGs (no trailing
# slash). Production sets it from the DOWNLOAD_BASE_URL GitHub variable; when
# empty the landing's download button points at GitHub Releases.
VITE_PUBLIC_DOWNLOAD_URL=
