# Point these at the deployment created by `bun --filter @monorepo-template/convex-auth-api dev:setup`.
# Data URL (.convex.cloud) — the deployment the app talks to.
EXPO_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
# Site URL (.convex.site) — Better Auth serves /api/auth/* here.
EXPO_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site
