# -----------------------------------------------------------------------------
# macOS code signing & notarization (Developer ID / direct download)
#
# Copy to `.env.signing` and fill in. `.env.signing` is gitignored; this .example
# is tracked.
#
# These are the exact names electron-builder reads from the environment. They are
# deliberately NOT prefixed with VITE_/MAIN_VITE_, so they can never be inlined
# into the renderer bundle.
#
# What is secret and what is not:
#   - Secret:      the .p12 file, the .p8 file, and CSC_KEY_PASSWORD.
#   - Identifiers: Team ID, Key ID, Issuer ID — these already appear in the
#                  signature and in electron-builder.yml.
# -----------------------------------------------------------------------------

# --- Signing (Developer ID Application) ---
# ABSOLUTE path to the .p12 locally; in CI this holds the file's base64 instead.
CSC_LINK=/Users/<user>/.secrets/<app>/signing-certificates.p12
# The password set when EXPORTING the .p12 — not your Mac password or Apple ID.
CSC_KEY_PASSWORD=

# --- Notarization (App Store Connect API Key) ---
# ABSOLUTE path to the .p8 locally; in CI this holds the file's base64 instead.
APPLE_API_KEY=/Users/<user>/.secrets/<app>/AuthKey_<KEY_ID>.p8
# Key ID: 10 characters, and part of the .p8 filename.
APPLE_API_KEY_ID=
# Issuer ID: a UUID from App Store Connect -> Users and Access -> Integrations.
# Required for Team Keys; omit it for an Individual Key.
APPLE_API_ISSUER=
