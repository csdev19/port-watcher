{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "Capability for the Settings window",
  "windows": ["settings"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "store:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://github.com/csdev19/port-watcher*" }]
    }
  ]
}
