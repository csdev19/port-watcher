{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "store:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "http://localhost:*" }, { "url": "http://127.0.0.1:*" }]
    }
  ]
}
