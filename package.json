{
  "name": "port-watcher",
  "version": "1.0.0",
  "private": true,
  "description": "A monorepo template with DDD + Hexagonal Architecture, auth, deployment configs, and a Todo CRUD example",
  "license": "MIT",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "4.3.6",
      "@types/bun": "^1.3.4",
      "better-auth": "1.4.18",
      "@tailwindcss/vite": "4.1.8",
      "tailwindcss": "4.1.18",
      "@vitejs/plugin-react": "5.1.2",
      "tsdown": "0.18.4",
      "vite": "7.3.0",
      "typescript": "5.9.3",
      "vitest": "^4.1.9",
      "jsdom": "^26.1.0",
      "@testing-library/react": "^16.3.0",
      "@testing-library/jest-dom": "^6.6.4",
      "@testing-library/user-event": "^14.6.1"
    }
  },
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "lint": "oxlint",
    "format": "oxfmt --write .",
    "format:tracked": "git ls-files | grep -E '\\.(ts|tsx|js|jsx|json|jsonc|md|mdx)$' | xargs oxfmt --write",
    "check": "bun run lint && bun run format",
    "dev": "turbo run dev tauri:dev",
    "build": "turbo run build",
    "build:no-cache": "turbo run build --force",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:unit": "turbo run test --filter=@port-watcher/domain --filter=@port-watcher/application",
    "test:web": "turbo run test --filter=@port-watcher/web-ui",
    "dev:fullstack-fn": "turbo run dev -F fullstack-fn-only",
    "dev:desktop": "turbo run tauri:dev -F desktop",
    "build:desktop": "turbo run tauri:build -F desktop",
    "db:push": "dotenvx run -f apps/fullstack-fn-only/.env -- turbo run db:push -F @port-watcher/infra-db",
    "db:studio": "dotenvx run -f apps/fullstack-fn-only/.env -- turbo run db:studio -F @port-watcher/infra-db",
    "db:generate": "dotenvx run -f apps/fullstack-fn-only/.env -- turbo run db:generate -F @port-watcher/infra-db",
    "db:migrate": "dotenvx run -f apps/fullstack-fn-only/.env -- turbo run db:migrate -F @port-watcher/infra-db"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251213.0",
    "@types/bun": "catalog:",
    "jose": "^6.1.3",
    "lefthook": "^2.1.12",
    "oxfmt": "^0.19.0",
    "oxlint": "^1.34.0",
    "turbo": "^2.6.3",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.3.4"
}
