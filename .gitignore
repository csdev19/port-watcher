# Dependencies
node_modules
.pnp
.pnp.js

# Build outputs
dist
build
.next
.wrangler
*.tsbuildinfo

# Rust / Tauri
target
apps/desktop/src-tauri/gen/schemas

# Environment variables: every .env variant (.env.signing, .env.production,
# .env.local, .env.keys, ...) in any folder; only the examples are tracked.
.env
.env.*
.dev.vars
.dev.vars.*
!.env.example
!*.env.example
!.dev.vars.example

# Signing material and private keys (Developer ID .p12, App Store Connect
# .p8, PEM keys). These live in GitHub secrets, never in the repo.
*.p12
*.p8
*.pem
*.key
*.keychain
*.keychain-db

# IDEs and editors
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea
*.swp
*.swo
*~
.DS_Store

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Turbo
.turbo

# Testing
coverage
.nyc_output

# Misc
*.tgz
.cache
tmp
temp
pr-summaries/

# AI-generated scratch files kept locally for context but never tracked
workspace-temp/
# electron-vite build output (apps/desktop)
out/

# lefthook per-developer overrides (never committed)
lefthook-local.yml

# Local git worktrees (sdd execution)
.worktrees

# Written by release-web.yml for `wrangler deploy --secrets-file`; never commit
worker-secrets.json

# Owner-only values for scripts/production-env.sh; never commit
.production.env
